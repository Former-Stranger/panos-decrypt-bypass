# panos-decrypt-bypass settings. Copy to .env and fill in. Never commit .env.
# Every variable is described in docs/configuration.md.

# --- Web GUI login (required) --------------------------------------------------
# At least 12 characters. Set WEBGUI_AUTH=none instead only if something in
# front of the app (e.g. your reverse proxy) already requires a login.
WEBGUI_PASSWORD=
# WEBGUI_AUTH=password
# WEBGUI_SESSION_HOURS=12

# --- How the firewall is managed -----------------------------------------------
# scm:   managed by Strata Cloud Manager. Bypasses are created in SCM and pushed.
# local: configured on the firewall itself (not by SCM or Panorama). Bypasses
#        are created on the firewall and committed.
MANAGEMENT=scm

# --- Strata Cloud Manager (MANAGEMENT=scm only) ----------------------------------
# A service account (Settings > Identity & Access > Add Identity > Service
# Account) with a role that can edit configuration and push.
# See docs/prerequisites.md.
SCM_CLIENT_ID=my-sa@1234567890.iam.panserviceaccount.com
SCM_CLIENT_SECRET=
SCM_SCOPE=tsg_id:1234567890
# SCM_HOST=api.sase.paloaltonetworks.com
# SCM_AUTH_URL=https://auth.apps.paloaltonetworks.com/auth/v1/oauth2/access_token

# --- Firewall (required) ---------------------------------------------------------
# Management address of the firewall; must match a name in its certificate.
FIREWALL_HOST=firewall.example.com
# XML API key. With MANAGEMENT=scm it only needs to read logs; with
# MANAGEMENT=local it also changes config and commits (see docs/prerequisites.md).
FIREWALL_API_KEY=
# MANAGEMENT=local only: the admin that owns FIREWALL_API_KEY. Commits include
# only this admin's changes.
# FIREWALL_USERNAME=decrypt-bypass
# Timezone the firewall writes log timestamps in.
FIREWALL_TIMEZONE=UTC
# If the management certificate comes from a private CA, mount the CA file
# (see compose.yaml) and point to it. Avoid FIREWALL_VERIFY_TLS=false.
# FIREWALL_CA_FILE=/certs/firewall-ca.pem
# FIREWALL_VERIFY_TLS=true

# --- Log polling (optional) ------------------------------------------------------
# POLL_SECONDS=300
# INITIAL_LOOKBACK_HOURS=24
# RETENTION_DAYS=7
# FIREWALL_LOG_QUERY=(addr.src in 192.0.2.0/24)

# --- Container (optional) -----------------------------------------------------
# Owner of ./data on the host (id -u / id -g).
# PUID=1000
# PGID=1000
# Host port for the GUI.
# WEBGUI_PORT=8088
